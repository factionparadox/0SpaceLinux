{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "@LOGO_TXT@",
    "color": {
      "1": "cyan",
      "2": "blue"
    },
    "padding": {
      "top": 1,
      "left": 2,
      "right": 3
    }
  },
  "display": {
    "separator": " ",
    "color": {
      "keys": "blue",
      "title": "yellow",
      "output": "white",
      "separator": "cyan"
    },
    "key": {
      "width": 12
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "{user-name-colored}{at-symbol-colored}{host-name-colored}",
      "color": {
        "user": "yellow",
        "at": "blue",
        "host": "cyan"
      }
    },
    {
      "type": "custom",
      "format": "\u001b[34m──────────────────────────────────\u001b[0m"
    },
    {
      "type": "os",
      "key": "Design",
      "format": "{name} {version-id}"
    },
    {
      "type": "host",
      "key": "Hull",
      "format": "{name}"
    },
    {
      "type": "kernel",
      "key": "Kernel",
      "format": "{release}"
    },
    {
      "type": "uptime",
      "key": "Morphed"
    },
    {
      "type": "packages",
      "key": "Forms"
    },
    {
      "type": "wm",
      "key": "Carousel",
      "format": "{pretty-name}"
    },
    {
      "type": "display",
      "key": "Viewscreen",
      "format": "{width}x{height} @ {scale-factor}x"
    },
    {
      "type": "cpu",
      "key": "Mind",
      "format": "{name}"
    },
    {
      "type": "gpu",
      "key": "Sight",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": "Memory"
    },
    {
      "type": "swap",
      "key": "Z-space"
    },
    {
      "type": "disk",
      "key": "Hold",
      "folders": "/",
      "format": "{size-used} / {size-total} ({size-percentage})"
    },
    {
      "type": "battery",
      "key": "Power"
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[33m< Dome integrity nominal. >\u001b[0m"
    },
    "break",
    {
      "type": "colors",
      "symbol": "block",
      "paddingLeft": 0
    }
  ]
}
