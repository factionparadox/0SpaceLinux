{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",
    "source": "@LOGO_PNG@",
    "width": 16,
    "height": 8,
    "padding": {
      "top": 2,
      "left": 1,
      "right": 2
    }
  },
  "display": {
    "separator": " ",
    "color": {
      "keys": "blue",
      "title": "yellow",
      "output": "white",
      "separator": "cyan"
    },
    "key": {
      "width": 24
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "\u001b[33m􀁡􀁲􀁩􀁳􀁴􀁨/Aristh\u001b[0m {user-name-colored}\u001b[34m of the Dome ship \u001b[0m{host-name-colored}",
      "color": {
        "user": "yellow",
        "at": "blue",
        "host": "cyan"
      }
    },
    {
      "type": "custom",
      "format": "\u001b[34m──────────────────────────────────\u001b[0m"
    },
    {
      "type": "os",
      "key": "􀁤􀁯􀁭􀁥 􀁳􀁨􀁩􀁰/Dome ship",
      "format": "{name} {version-id}"
    },
    {
      "type": "host",
      "key": "􀁨􀁵􀁬􀁬/Hull",
      "format": "{name}"
    },
    {
      "type": "kernel",
      "key": "􀁣􀁯􀁲􀁥/Core",
      "format": "{release}"
    },
    {
      "type": "uptime",
      "key": "􀁭􀁯􀁲􀁰􀁨 􀁴􀁩􀁭􀁥/Morph time",
      "format": "{hours}h {minutes}m / 2h limit"
    },
    {
      "type": "packages",
      "key": "􀁦􀁯􀁲􀁭􀁳/Forms"
    },
    {
      "type": "wm",
      "key": "􀁣􀁡􀁲􀁯􀁵􀁳􀁥􀁬/Carousel",
      "format": "{pretty-name}"
    },
    {
      "type": "display",
      "key": "􀁶􀁩􀁥􀁷􀁳􀁣􀁲􀁥􀁥􀁮/Viewscreen",
      "format": "{width}x{height} @ {scale-factor}x"
    },
    {
      "type": "cpu",
      "key": "􀁭􀁩􀁮􀁤/Mind",
      "format": "{name}"
    },
    {
      "type": "gpu",
      "key": "􀁳􀁴􀁡􀁬􀁫 􀁥􀁹􀁥􀁳/Stalk eyes",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": "􀁭􀁥􀁭􀁯􀁲􀁹/Memory"
    },
    {
      "type": "swap",
      "key": "􀁺-􀁳􀁰􀁡􀁣􀁥/Z-space"
    },
    {
      "type": "disk",
      "key": "􀁨􀁯􀁬􀁤/Hold",
      "folders": "/",
      "format": "{size-used} of {size-total}"
    },
    {
      "type": "battery",
      "key": "􀁰􀁯􀁷􀁥􀁲 􀁣􀁥􀁬􀁬􀁳/Power cells"
    },
    "break",
    {
      "type": "command",
      "key": " ",
      "keyWidth": 1,
      "text": "shuf -n1 @SAYINGS@ 2>/dev/null || echo '< The Dome holds. >'",
      "outputColor": "yellow"
    },
    "break",
    {
      "type": "colors",
      "symbol": "diamond",
      "paddingLeft": 0
    }
  ]
}
