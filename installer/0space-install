#!/usr/bin/env bash
# 0space-install: put a Dome ship on this machine.
#
# Runs by itself on the installer's first console. Every answer is a choice
# or a yes/no; the only things typed are the ship's name, your name and your
# password. The ship's packages are already on the stick; only the few parts
# made for this machine's hardware are downloaded.

set -euo pipefail

SOURCE=/etc/0space-flake
# The console carries the Andalite palette, so these are its 16 colours:
# 0 night, 1 red, 3 fur tan, 4 fur blue, 6 dome glass, 7 text, 8 dim.
export GUM_CONFIRM_PROMPT_FOREGROUND=3
export GUM_CONFIRM_SELECTED_FOREGROUND=0 GUM_CONFIRM_SELECTED_BACKGROUND=6
export GUM_CONFIRM_UNSELECTED_FOREGROUND=7 GUM_CONFIRM_UNSELECTED_BACKGROUND=8
export GUM_CHOOSE_CURSOR_FOREGROUND=6 GUM_CHOOSE_SELECTED_FOREGROUND=6 GUM_CHOOSE_ITEM_FOREGROUND=7
export GUM_INPUT_PROMPT_FOREGROUND=3 GUM_INPUT_CURSOR_FOREGROUND=6 GUM_INPUT_PLACEHOLDER_FOREGROUND=8
# nmtui (the Wi-Fi screen) in the same colours. newt's names for the console
# palette: black night, blue fur blue, brown fur tan, cyan dome glass,
# lightgray text, red red.
export NEWT_COLORS='root=lightgray,black;window=lightgray,black;border=blue,black;shadow=black,black;title=brown,black;label=brown,black;textbox=lightgray,black;acttextbox=black,cyan;entry=lightgray,black;disentry=gray,black;listbox=lightgray,black;actlistbox=black,cyan;sellistbox=brown,black;actsellistbox=black,cyan;button=lightgray,black;actbutton=black,cyan;compactbutton=lightgray,black;checkbox=lightgray,black;actcheckbox=black,cyan;emptyscale=,black;fullscale=,blue;helpline=brown,black;roottext=brown,black'
STYLE=(--border rounded --border-foreground 4 --padding "1 2" --margin "1 0")

say() { gum style --foreground 6 "< $* >"; }
fail() { gum style --foreground 1 "< $* >"; exit 1; }

clear
gum style "${STYLE[@]}" --bold --foreground 3 \
    "0-Space Linux" "" "An Andalite Dome ship, ready to be put on this machine." \
    "" "Everything on the disk you choose will be erased."

gum confirm "Begin installation, aristh?" || exit 0

# --- network -----------------------------------------------------------------------
# Most of the ship comes off the stick, but the few parts made for this
# machine's own hardware are fetched from the NixOS cache, so a connection is
# needed. It is a small download.
online() { curl -sfI --max-time 8 https://cache.nixos.org/nix-cache-info >/dev/null; }
until online; do
    say "The Dome needs a short connection to fetch the parts made for this machine."
    gum confirm "Connect to Wi-Fi now?" || fail "Installation needs a connection. Run 0space-install when you have one."
    nmtui-connect || true
done

# --- disk ----------------------------------------------------------------------
mapfile -t disks < <(lsblk -dpno NAME,SIZE,MODEL -e 2,7,11 | sed 's/  */ /g')
[ "${#disks[@]}" -gt 0 ] || fail "No disks found."
say "Choose the disk to install to."
choice="$(printf '%s\n' "${disks[@]}" | gum choose)"
disk="${choice%% *}"
gum confirm --default=false "Erase ALL of $choice?" || exit 0

# --- names ---------------------------------------------------------------------
host="$(gum input --placeholder "dome" --prompt "Ship's name: " --value "dome")"
host="$(printf '%s' "${host:-dome}" | tr -c 'a-zA-Z0-9-' '-' | sed 's/-*$//')"
user="$(gum input --placeholder "your login name" --prompt "Your name: ")"
user="$(printf '%s' "$user" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9_-' '_' | sed 's/_*$//')"
[ -n "$user" ] || fail "A name is needed."
while true; do
    pass1="$(gum input --password --prompt "Password: ")"
    pass2="$(gum input --password --prompt "Again: ")"
    [ -n "$pass1" ] && [ "$pass1" = "$pass2" ] && break
    say "Those did not match. Again."
done

# --- partitions ------------------------------------------------------------------
say "Preparing $disk."
wipefs -af "$disk" >/dev/null
parted -s "$disk" -- mklabel gpt \
    mkpart ESP fat32 1MiB 1GiB set 1 esp on \
    mkpart 0space ext4 1GiB 100%
udevadm settle
part() { lsblk -lnpo NAME "$disk" | sed -n "$(( $1 + 1 ))p"; }
efi="$(part 1)"
root="$(part 2)"
mkfs.fat -F 32 -n 0SPACE-EFI "$efi" >/dev/null
mkfs.ext4 -qF -L 0space "$root"
mount "$root" /mnt
mkdir -p /mnt/boot
mount -o umask=0077 "$efi" /mnt/boot

# --- which machine is this? ----------------------------------------------------------
# Framework laptops get their nixos-hardware module, chosen by processor
# (more dependable than the exact model string in the firmware).
hardware_module() {
    local vendor product cpu
    vendor=$(cat /sys/class/dmi/id/sys_vendor 2>/dev/null || true)
    product=$(cat /sys/class/dmi/id/product_name 2>/dev/null || true)
    cpu=$(sed -n 's/^model name[[:space:]]*: //p' /proc/cpuinfo | head -1)
    [[ $vendor == Framework* ]] || return 0
    case "$product|$cpu" in
        *16*"|"*"Ryzen AI"*)               echo framework-16-amd-ai-300-series ;;
        *16*"|"*Ryzen*)                    echo framework-16-7040-amd ;;
        *Desktop*)                         echo framework-desktop-amd-ai-max-300-series ;;
        *"|"*"Ultra "[0-9]" 3"[0-9][0-9]*) echo framework-intel-core-ultra-series3 ;;
        *"|"*"Ultra "[0-9]" 1"[0-9][0-9]*) echo framework-intel-core-ultra-series1 ;;
        *"|"*"Ryzen AI"*)                  echo framework-amd-ai-300-series ;;
        *"|"*Ryzen*)                       echo framework-13-7040-amd ;;
        *12*"|"*"13th Gen"*)               echo framework-12-13th-gen-intel ;;
        *"|"*"13th Gen"*)                  echo framework-13th-gen-intel ;;
        *"|"*"12th Gen"*)                  echo framework-12th-gen-intel ;;
        *"|"*"11th Gen"*)                  echo framework-11th-gen-intel ;;
    esac
}
machine=$(hardware_module)
if [ -n "$machine" ]; then
    say "This is a $(cat /sys/class/dmi/id/product_name 2>/dev/null || echo Framework). Its hardware module ($machine) goes in."
    machine_import="    inputs.nixos-hardware.nixosModules.$machine"
else
    machine_import=""
fi

# --- the ship's design -------------------------------------------------------------
say "Writing the ship's design."
mkdir -p /mnt/etc/0space
cp -r "$SOURCE"/. /mnt/etc/0space/
chmod -R u+w /mnt/etc/0space
hostdir="/mnt/etc/0space/hosts/$host"
rm -rf "$hostdir"
mkdir -p "$hostdir"
nixos-generate-config --root /mnt --show-hardware-config > "$hostdir/hardware.nix" 2>/dev/null
printf "# Forms acquired with escafil acquire. One nixpkgs attribute per line.\n[\n]\n" > "$hostdir/forms.nix"
cat > "$hostdir/default.nix" <<EOF
# The Dome ship "$host". Change it, then: escafil morph
{ inputs, ... }:
{
  imports = [
    ./hardware.nix
$machine_import
  ];
  zerospace.user = "$user";
  zerospace.forms = import ./forms.nix;
  system.stateVersion = "26.05";
}
EOF

# --- install ---------------------------------------------------------------------------
say "Assembling the Dome. This takes a few minutes."
nixos-install --flake "/mnt/etc/0space#$host" --no-root-passwd --no-channel-copy
printf '%s:%s\n' "$user" "$pass1" | nixos-enter --root /mnt -c chpasswd

gum style "${STYLE[@]}" --foreground 3 \
    "< The Dome ship $host is ready. >" "" \
    "Remove the stick when the screen goes dark."
gum confirm "Restart now?" && reboot
