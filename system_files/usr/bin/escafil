#!/usr/bin/bash
# escafil: acquire and shed forms on 0-Space.
#
#   escafil acquire <form...>   add packages to your system (rpm-ostree)
#   escafil shed <form...>      remove packages you acquired
#   escafil forms               list the forms you have acquired
#   escafil jump                fetch the newest 0-Space image (applies at restart)
#   escafil demorph             return to the previous image at next restart
#   escafil scan                report the state of the Dome
#
# The system itself is an image: nothing here changes the running system
# until you restart, and `escafil demorph` always takes you back one step.

set -euo pipefail

say() { printf '< %s >\n' "$*"; }

need_prince() {
    if [ "$(id -u)" -ne 0 ]; then
        say "A prince's authority is required for this action."
        exec sudo -- "$0" "$@"
    fi
}

verb="${1:-help}"
shift || true

case "$verb" in
    acquire)
        [ $# -gt 0 ] || { say "Acquire what, aristh? Name the form."; exit 1; }
        need_prince acquire "$@"
        rpm-ostree install --idempotent "$@"
        say "Form acquired: $*. It becomes available after the next restart."
        ;;
    shed)
        [ $# -gt 0 ] || { say "Shed what, aristh? Name the form."; exit 1; }
        need_prince shed "$@"
        rpm-ostree uninstall "$@"
        say "Form shed: $*. It is gone after the next restart."
        ;;
    forms)
        forms=$(rpm-ostree status --json | python3 -c 'import json,sys; d=json.load(sys.stdin)["deployments"][0]; print(" ".join(d.get("requested-packages", [])))')
        if [ -n "$forms" ]; then
            say "Acquired forms: $forms"
        else
            say "No forms acquired beyond the Dome's own."
        fi
        ;;
    jump)
        need_prince jump
        say "Plotting a Z-space jump to the newest image."
        bootc upgrade
        say "Jump prepared. It completes at the next restart."
        ;;
    demorph)
        need_prince demorph
        bootc rollback
        say "Demorph prepared. You return to your previous form at the next restart."
        ;;
    scan)
        bootc status
        ;;
    help|-h|--help)
        sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'
        ;;
    *)
        say "Unknown order: $verb. Try: escafil help"
        exit 1
        ;;
esac
