#!/usr/bin/bash
# Start the 0-Space session: Wayfire with the ring, the Dome and thought-speak.
export XDG_CURRENT_DESKTOP=0space:wlroots
export XDG_SESSION_DESKTOP=0space
export XDG_SESSION_TYPE=wayland
export MOZ_ENABLE_WAYLAND=1
export QT_QPA_PLATFORM=wayland

config="$HOME/.config/wayfire.ini"
[ -f "$config" ] || config=/usr/share/0space/wayfire.ini

exec wayfire -c "$config"
