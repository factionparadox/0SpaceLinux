#!/usr/bin/bash
# First boot: log the first real user straight into 0-Space.
set -euo pipefail
conf=/etc/greetd/config.toml

grep -q '^\[initial_session\]' "$conf" && exit 0

user=$(getent passwd | awk -F: '$3 >= 1000 && $3 < 60000 && $7 !~ /(nologin|false)$/ {print $1; exit}')
if [ -z "$user" ]; then
    echo "< No aristh found to log in. Autologin stays off. >"
    exit 0
fi

printf '\n[initial_session]\ncommand = "0space-session"\nuser = "%s"\n' "$user" >> "$conf"
echo "< Autologin set for $user. >"
